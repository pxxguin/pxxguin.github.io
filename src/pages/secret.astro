---
// This page intentionally does NOT use MainGridLayout / Layout.
// It's meant to break out of the blog's look entirely.
import "@fontsource-variable/jetbrains-mono";
import { getCollection } from "astro:content";
import AchievementsPanel from "@components/misc/AchievementsPanel.svelte";
import TrophyShelf from "@components/misc/TrophyShelf.svelte";
import { getCategoryList } from "../utils/content-utils";

const title = "root@server:~#";
const description = "Access granted.";

const posts = await getCollection("posts");
const totalPosts = posts.length;

const categories = await getCategoryList();
const totalCategories = categories.length;

const allTags = posts.flatMap((post) => post.data.tags || []);
const uniqueTags = new Set(allTags);
const totalTags = uniqueTags.size;

const sortedPosts = posts.sort(
	(a, b) =>
		new Date(a.data.published).getTime() - new Date(b.data.published).getTime(),
);
const runningDays = sortedPosts[0]?.data.published
	? Math.floor(
			(Date.now() - new Date(sortedPosts[0].data.published).getTime()) /
				(1000 * 60 * 60 * 24),
		)
	: 0;

const latestPost = [...posts].sort(
	(a, b) =>
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
)[0];
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon/favicon-light.ico" sizes="32x32" />
	</head>
	<body class="bg-black text-[#3ef07f] font-mono min-h-screen overflow-x-hidden selection:bg-[#3ef07f] selection:text-black">
		<canvas id="matrix-rain" class="fixed inset-0 w-full h-full z-0 opacity-40"></canvas>
		<div class="crt-overlay fixed inset-0 z-10 pointer-events-none"></div>
		<div class="vignette fixed inset-0 z-10 pointer-events-none"></div>

		<div id="boot-screen" class="relative z-20 min-h-screen flex items-center justify-center px-6">
			<pre id="boot-log" class="text-sm md:text-base leading-relaxed text-[#3ef07f] whitespace-pre-wrap"></pre>
		</div>

		<main id="dashboard" class="relative z-20 hidden min-h-screen px-4 py-10 md:px-10">
			<div class="max-w-5xl mx-auto space-y-8">
				<header class="space-y-2">
					<h1 class="glitch text-2xl md:text-4xl font-bold tracking-tight" data-text="ACCESS GRANTED">ACCESS GRANTED</h1>
					<p id="last-login" class="text-[#3ef07f]/60 text-xs md:text-sm">last login: -- from 127.0.0.1 (localhost)</p>
				</header>

				<section class="border border-[#3ef07f]/30 bg-black/40 rounded p-4 md:p-6 backdrop-blur-sm grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="space-y-1 text-sm md:text-base md:pr-4 md:border-r md:border-[#3ef07f]/20">
						<p class="text-[#3ef07f]/50 mb-2">$ cat /var/log/blog_stats.log</p>
						<p><span class="text-[#7ef9ff]">posts_total</span> = {totalPosts}</p>
						<p><span class="text-[#7ef9ff]">categories_total</span> = {totalCategories}</p>
						<p><span class="text-[#7ef9ff]">tags_total</span> = {totalTags}</p>
						<p><span class="text-[#7ef9ff]">uptime_days</span> = {runningDays}</p>
						{latestPost && (
							<p><span class="text-[#7ef9ff]">latest_deploy</span> = "{latestPost.data.title}"</p>
						)}
					</div>

					<TrophyShelf client:load />
				</section>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
					<section class="h-full border border-dashed border-yellow-600/60 bg-yellow-950/10 rounded p-4 md:p-6 backdrop-blur-sm">
						<p class="text-yellow-400 text-xs mb-3">// [DECLASSIFIED] personal note from admin</p>
						<div class="text-[#c9ffdb] leading-relaxed text-sm md:text-base space-y-3">
							<p>
								여기까지 찾아왔다는 건, 제가 숨겨놓은 이스터에그를 1개 찾았다는 거겠죠?
								별거 없는 이 블로그에 이런 이스터에그를 만들어 둘 정도로, 이 블로그를 많이 아낀다는 뜻으로 봐주세요.
							</p>
							<p>
								지금 이 글을 적는 시점이 이 블로그를 만든 지 500일 정도 되는 것 같아요.
								그동안 작성한 글들이 맘에 안 들어서 많이 지워서 글이 많이 없어졌군요..
							</p>
							<p>
								근데 지금은 이 페이지도 그렇고, Claude의 놀라운 능력을 보고 많이 놀라는 중입니다.
								제가 아주 오래 고민했던 코드를 무려 1시간도 안 걸려 완성하더라고요.
							</p>
							<p>
								그래도 이 글을 읽는 분들은 이 대격변의 시대에서도 자신감을 잃지 않았으면 좋겠습니다.
								압도적인 실력은 결코 배신하지 않을 것이라고 생각하기 때문에, 본인이 잘하는 것을 꾸준하게 Digging한다면,
								아마 다른 지원자들과 많이 다를거라고 생각합니다.
							</p>
							<p>
								그럼 지금까지 짧은 글 읽어주셔서 감사합니다. 나머지 이스터에그도 블로그 곳곳에 숨겨두었으니, 찾을 수 있다면 한번 찾아보시죠!
							</p>
							<p class="text-[#c9ffdb]/70 text-right text-xs md:text-sm pt-1">— 개발자 @pxxguin 드림 🙌</p>
						</div>
					</section>

					<section class="h-full border border-[#3ef07f]/30 bg-black/40 rounded p-4 md:p-6 backdrop-blur-sm">
						<AchievementsPanel client:load />
					</section>
				</div>

				<footer class="flex items-center justify-end border-t border-[#3ef07f]/20 pt-6 text-sm">
					<button
						id="logout-btn"
						class="text-red-400 hover:underline bg-transparent border-none cursor-pointer font-mono text-sm"
					>
						$ exit
					</button>
				</footer>
			</div>
		</main>

		<script>
			import { clearAccess, hasAccess } from "@utils/access-key";

			if (!hasAccess()) {
				window.location.href = "/login/";
			}

			document.getElementById("logout-btn")?.addEventListener("click", () => {
				clearAccess();
				window.location.href = "/";
			});

			const lastLoginEl = document.getElementById("last-login");
			if (lastLoginEl) {
				lastLoginEl.textContent = `last login: ${new Date().toUTCString()} from 127.0.0.1 (localhost)`;
			}

			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			// --- matrix rain background ---
			function initMatrixRain() {
				const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement | null;
				if (!canvas) return;
				const ctx = canvas.getContext("2d");
				if (!ctx) return;

				const glyphs = "アイウエオカキクケコサシスセソ0123456789$#%&+-<>/\\";
				const fontSize = 16;
				let width = 0;
				let height = 0;
				let drops: number[] = [];

				function resize() {
					width = canvas!.width = window.innerWidth;
					height = canvas!.height = window.innerHeight;
					const columns = Math.floor(width / fontSize);
					drops = new Array(columns).fill(0).map(() => Math.floor(Math.random() * -50));
				}
				resize();
				window.addEventListener("resize", resize);

				if (reduceMotion) {
					// single static-ish frame, no animation loop
					ctx.fillStyle = "black";
					ctx.fillRect(0, 0, width, height);
					return;
				}

				function draw() {
					if (!ctx) return;
					ctx.fillStyle = "rgba(0, 0, 0, 0.09)";
					ctx.fillRect(0, 0, width, height);
					ctx.font = `${fontSize}px monospace`;
					for (let i = 0; i < drops.length; i++) {
						const glyph = glyphs[Math.floor(Math.random() * glyphs.length)];
						ctx.fillStyle = Math.random() > 0.97 ? "#c9ffdb" : "#22c55e";
						ctx.fillText(glyph, i * fontSize, drops[i] * fontSize);
						if (drops[i] * fontSize > height && Math.random() > 0.975) {
							drops[i] = 0;
						}
						drops[i]++;
					}
				}
				setInterval(draw, 40);
			}

			// --- boot sequence typewriter ---
			const bootLines = [
				"[    0.0000] initializing kernel modules ...",
				"[    0.1421] loading driver: stealth.ko ................. OK",
				"[    0.4213] establishing encrypted tunnel ............... OK",
				"[    0.8123] bypassing firewall rules .................... OK",
				"[    1.2031] verifying session token ..................... OK",
				"[    1.5320] mounting /dev/blog on / ..................... OK",
				"",
				">>> ACCESS GRANTED. welcome back, root.",
			];

			async function runBoot() {
				const logEl = document.getElementById("boot-log");
				const bootScreen = document.getElementById("boot-screen");
				const dashboard = document.getElementById("dashboard");
				if (!logEl || !bootScreen || !dashboard) return;

				if (reduceMotion) {
					logEl.textContent = bootLines.join("\n");
					bootScreen.classList.add("hidden");
					dashboard.classList.remove("hidden");
					return;
				}

				for (const line of bootLines) {
					let current = "";
					for (const char of line) {
						current += char;
						logEl.textContent = logEl.textContent
							? logEl.textContent.replace(/[^\n]*$/, current)
							: current;
						await new Promise((r) => setTimeout(r, 8));
					}
					logEl.textContent += "\n";
					await new Promise((r) => setTimeout(r, 90));
				}

				await new Promise((r) => setTimeout(r, 400));
				bootScreen.classList.add("fade-out");
				await new Promise((r) => setTimeout(r, 350));
				bootScreen.classList.add("hidden");
				dashboard.classList.remove("hidden");
			}

			initMatrixRain();
			runBoot();
		</script>

		<style>
			.crt-overlay {
				background: repeating-linear-gradient(
					to bottom,
					rgba(0, 0, 0, 0) 0px,
					rgba(0, 0, 0, 0) 1px,
					rgba(0, 0, 0, 0.35) 2px,
					rgba(0, 0, 0, 0.35) 3px
				);
				animation: flicker 6s infinite;
			}
			.vignette {
				background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.75) 100%);
			}
			@keyframes flicker {
				0%, 96%, 100% { opacity: 1; }
				97% { opacity: 0.85; }
				98% { opacity: 1; }
			}

			#boot-screen {
				transition: opacity 0.35s ease-out;
			}
			#boot-screen.fade-out {
				opacity: 0;
			}
			#boot-log {
				text-shadow: 0 0 6px rgba(62, 240, 127, 0.6);
			}

			.cursor::after {
				content: "\2588";
				margin-left: 2px;
				animation: blink 1s steps(1) infinite;
			}
			@keyframes blink {
				50% { opacity: 0; }
			}

			.glitch {
				position: relative;
				text-shadow: 0 0 8px rgba(62, 240, 127, 0.7);
			}
			.glitch::before,
			.glitch::after {
				content: attr(data-text);
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				overflow: hidden;
				background: black;
			}
			.glitch::before {
				left: 2px;
				text-shadow: -1px 0 #ff2ecc;
				animation: glitch-1 3.2s infinite linear alternate-reverse;
			}
			.glitch::after {
				left: -2px;
				text-shadow: -1px 0 #2ecfff;
				animation: glitch-2 2.6s infinite linear alternate-reverse;
			}
			@keyframes glitch-1 {
				0% { clip-path: inset(10% 0 85% 0); }
				20% { clip-path: inset(70% 0 5% 0); }
				40% { clip-path: inset(40% 0 45% 0); }
				60% { clip-path: inset(5% 0 80% 0); }
				80% { clip-path: inset(60% 0 20% 0); }
				100% { clip-path: inset(30% 0 60% 0); }
			}
			@keyframes glitch-2 {
				0% { clip-path: inset(60% 0 25% 0); }
				20% { clip-path: inset(15% 0 70% 0); }
				40% { clip-path: inset(80% 0 5% 0); }
				60% { clip-path: inset(35% 0 50% 0); }
				80% { clip-path: inset(5% 0 85% 0); }
				100% { clip-path: inset(50% 0 30% 0); }
			}

			@media (prefers-reduced-motion: reduce) {
				.crt-overlay { animation: none; }
				.glitch::before, .glitch::after { animation: none; content: none; }
				.cursor::after { animation: none; }
			}
		</style>
	</body>
</html>
