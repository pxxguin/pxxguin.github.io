---
import { getCollection } from "astro:content";
import AchievementsPanel from "@components/misc/AchievementsPanel.svelte";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getCategoryList } from "../utils/content-utils";

const title = "root@server";
const description = "Access granted.";

const posts = await getCollection("posts");
const totalPosts = posts.length;

const categories = await getCategoryList();
const totalCategories = categories.length;

const allTags = posts.flatMap((post) => post.data.tags || []);
const uniqueTags = new Set(allTags);
const totalTags = uniqueTags.size;

const sortedPosts = posts.sort(
	(a, b) =>
		new Date(a.data.published).getTime() - new Date(b.data.published).getTime(),
);
const runningDays = sortedPosts[0]?.data.published
	? Math.floor(
			(Date.now() - new Date(sortedPosts[0].data.published).getTime()) /
				(1000 * 60 * 60 * 24),
		)
	: 0;

const latestPost = [...posts].sort(
	(a, b) =>
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
)[0];
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full justify-center py-10">
		<div class="w-full max-w-3xl bg-[#1e1e1e] rounded-lg shadow-2xl overflow-hidden border border-green-700 font-mono">
			<div class="px-4 py-3 border-b border-green-700 bg-[#173821] flex items-center gap-2">
				<div class="w-3 h-3 rounded-full bg-red-500"></div>
				<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
				<div class="w-3 h-3 rounded-full bg-green-500"></div>
				<div class="flex-1 text-center text-xs text-green-200 select-none">root@server — -zsh — 80x24</div>
			</div>

			<div class="flex flex-col md:flex-row">
				<!-- LEFT: welcome + stats + note -->
				<div class="p-6 space-y-5 text-sm md:text-base text-gray-300 md:w-1/2 md:border-r md:border-green-900/50">
					<div>
						<p class="text-green-400 font-bold">🔓 ACCESS GRANTED.</p>
						<p class="text-gray-500 text-xs mt-1">last login: {new Date().toUTCString()} from 127.0.0.1</p>
					</div>

					<div class="border border-gray-700 rounded bg-black/30 p-4 space-y-1">
						<p class="text-gray-500 mb-2">$ cat /var/log/blog_stats.log</p>
						<p><span class="text-blue-400">posts_total</span> = {totalPosts}</p>
						<p><span class="text-blue-400">categories_total</span> = {totalCategories}</p>
						<p><span class="text-blue-400">tags_total</span> = {totalTags}</p>
						<p><span class="text-blue-400">uptime_days</span> = {runningDays}</p>
						{latestPost && (
							<p><span class="text-blue-400">latest_deploy</span> = "{latestPost.data.title}"</p>
						)}
					</div>

					<div class="border border-dashed border-yellow-700 rounded bg-yellow-950/20 p-4">
						<p class="text-yellow-400 text-xs mb-2">// [DECLASSIFIED] personal note from admin</p>
						<p class="text-gray-300 leading-relaxed">
							여기까지 찾아왔다는 건, 코나미 커맨드도 치고 시스템 파일도 뒤져보고 로그인까지 뚫었다는 뜻이겠죠.
							별거 없는 블로그에 이런 걸 만들어 둘 정도로 이 공간을 아낀다는 뜻으로 봐주세요. 와줘서 고마워요 🙌
						</p>
					</div>
				</div>

				<!-- RIGHT: trophy cabinet -->
				<div class="p-6 md:w-1/2">
					<AchievementsPanel client:load />
				</div>
			</div>

			<div class="flex items-center justify-between px-6 pb-6">
				<a href="/" class="text-blue-400 hover:underline">&larr; back to safety</a>
				<button
					id="logout-btn"
					class="text-red-400 hover:underline bg-transparent border-none cursor-pointer font-mono text-sm"
				>
					logout
				</button>
			</div>
		</div>
	</div>
</MainGridLayout>

<script>
	import { clearAccess, hasAccess } from "@utils/access-key";

	if (!hasAccess()) {
		window.location.href = "/login/";
	}

	document.getElementById("logout-btn")?.addEventListener("click", () => {
		clearAccess();
		window.location.href = "/";
	});
</script>
